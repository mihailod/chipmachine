":ld (iy*),#|fd36*#",
":ld (hl),#|36#",
":ld hl,(@)|2a@",
":ld bc,(@)|ed4b@",
":ld de,(@)|ed5b@",
":ld sp,(@)|ed7b@",
":ld ix,(@)|dd2a@",
":ld iy,(@)|fd2a@",
":ld bc,@|01@",
":ld de,@|11@",
":ld hl,@|21@",
":ld sp,@|31@",
":ld ix,@|dd21@",
":ld iy,@|fd21@",
":ld a,(@)|3a@",
":ld (@),hl|22@",
":ld (@),bc|ed43@",
":ld (@),de|ed53@",
":ld (@),sp|ed73@",
":ld (@),ix|dd22@",
":ld (@),iy|fd22@",
":ld (@),a|32@",
":ld ixh,#|dd26#",
":ld ixl,#|dd2e#",
":ld iyh,#|fd26#",
":ld iyl,#|fd2e#",
":ld a,#|3e#",
":ld b,#|06#",
":ld c,#|0e#",
":ld d,#|16#",
":ld e,#|1e#",
":ld h,#|26#",
":ld l,#|2e#",
":or (ix*)|ddb6*",
":or (iy*)|fdb6*",
":or #|f6#",
":out (#),a|d3#",
":res 0,(ix*)|ddcb*86",
":res 0,(iy*)|fdcb*86",
":res 1,(ix*)|ddcb*8e",
":res 1,(iy*)|fdcb*8e",
":res 2,(ix*)|ddcb*96",
":res 2,(iy*)|fdcb*96",
":res 3,(ix*)|ddcb*9e",
":res 3,(iy*)|fdcb*9e",
":res 4,(ix*)|ddcb*a6",
":res 4,(iy*)|fdcb*a6",
":res 5,(ix*)|ddcb*ae",
":res 5,(iy*)|fdcb*ae",
":res 6,(ix*)|ddcb*b6",
":res 6,(iy*)|fdcb*b6",
":res 7,(ix*)|ddcb*be",
":res 7,(iy*)|fdcb*be",
":rlc (ix*)|ddcb*06",
":rlc (iy*)|fdcb*06",
":rl (ix*)|ddcb*16",
":rl (iy*)|fdcb*16",
":rrc (ix*)|ddcb*0e",
":rrc (iy*)|fdcb*0e",
":rr (ix*)|ddcb*1e",
":rr (iy*)|fdcb*1e",
":sbc a,(ix*)|dd9e*",
":sbc a,(iy*)|fd9e*",
":sbc (ix*)|dd9e*",
":sbc (iy*)|fd9e*",
":sbc a,#|de#",
":set 0,(ix*)|ddcb*c6",
":set 0,(iy*)|fdcb*c6",
":set 1,(ix*)|ddcb*ce",
":set 1,(iy*)|fdcb*ce",
":set 2,(ix*)|ddcb*d6",
":set 2,(iy*)|fdcb*d6",
":set 3,(ix*)|ddcb*de",
":set 3,(iy*)|fdcb*de",
":set 4,(ix*)|ddcb*e6",
":set 4,(iy*)|fdcb*e6",
":set 5,(ix*)|ddcb*ee",
":set 5,(iy*)|fdcb*ee",
":set 6,(ix*)|ddcb*f6",
":set 6,(iy*)|fdcb*f6",
":set 7,(ix*)|ddcb*fe",
":set 7,(iy*)|fdcb*fe",
":sla (ix*)|ddcb*26",
":sla (iy*)|fdcb*26",
":sra (ix*)|ddcb*2e",
":sra (iy*)|fdcb*2e",
":srl (ix*)|ddcb*3e",
":srl (iy*)|fdcb*3e",
":sub (ix*)|dd96*",
":sub (iy*)|fd96*",
":sub #|d6#",
":xor (ix*)|ddae*",
":xor (iy*)|fdae*",
":xor #|ee#"
};



void Z80AssError(string error)
{
	uint len,ptr,line,c;
	string str;

	if(Z80AssStop) return;

	Print("Z80Ass error: "+error+"\n");

	str=" "+(Z80AssLine+1)+": ";
	
	line=0;
	ptr=0;
	
	len=Z80AssOriginalSource.length();
	
	while(ptr<len)
	{
		c=Z80AssOriginalSource[ptr++];

		if(line==Z80AssLine)
		{
			if(c!='\n') str+=charFromCode(c); else break;
		}
		else
		{
			if(c=='\n') ++line;
		}
	}
	
	str+="\n";

	Print(str);

	Z80AssStop=true;
}



bool Z80AssCompareSrcPart(string str)
{
	uint i,ptr,len;

	ptr=Z80AssSourcePtr;
	len=str.length();
	
	for(i=0;i<len;++i) if(Z80AssSource[ptr++]!=str[i]) return false;

	return true;
}



bool Z80AssLabelIsCharAllowed(uint c)
{
	return ((c>='a'&&c<='z')||(c>='0'&&c<='9')||c=='_'||c=='.');
}



int Z80AssHexChar(uint c)
{
	if(c>='0'&&c<='9') return c-'0'; else return c-'a'+10;
}



void Z80AssEmitCode(uint value)
{
	Z80Mem[Z80AssProgramCounter++]=value;
}



void Z80AssEmitByte(int value)
{
	if(value<-255||value>255) Z80AssError("truncated to 8-bit!");

	Z80AssEmitCode(value);
}



void Z80AssEmitWord(int value)
{
	if(value<-65535||value>65535) Z80AssError("truncated to 16-bit!");

	Z80AssEmitCode(value&255);
	Z80AssEmitCode(value>>8);
}



int Z80AssRelativeOffset(int value)
{
	if(value<-128||value>127) Z80AssError("relative offset is out of range -128..127!");

	if(value<0) value=((0-value-1)^0xff)&0xff;

	return value;
}



int Z80AssParseNumber(void)
{
	int c,base,value;

	value=0;
	base=10;

	c=Z80AssSource[Z80AssSourcePtr];

	if(!(c>='0'&&c<='9')&&c!='#'&&c!='%') return 0x7fffffff;//not a number

	if(c=='#') base=16;
	if(c=='%') base=2;

	if(base!=10) ++Z80AssSourcePtr;

	while(Z80AssSourcePtr<Z80AssSourceLen)
	{
		c=Z80AssSource[Z80AssSourcePtr];

		if(c=='\n') break;

		if(c>='0'&&c<='9') c=c-'0'; else if(c>='a'&&c<='f') c=c-'a'+10;

		if(c<0||c>=base) break;

		value=value*base+c;

		++Z80AssSourcePtr;
	}

	return value;
}



int Z80AssParseEquation(uint pass)
{
	uint i;
	int n,result,value;
	string label;
	int8 c,alu,nalu;
	bool found;

	result=0;
	alu=0;
	nalu='=';//set first number as initial value

	while(Z80AssSourcePtr<Z80AssSourceLen)
	{
		c=Z80AssSource[Z80AssSourcePtr];

		if(c=='\n'||c==' '||c==')'||c==',') break;

		if(c=='$')//current translation address
		{
			++Z80AssSourcePtr;
			value=Z80AssProgramCounter;
			alu=nalu;
			nalu=0;
		}
		else
		{
			n=Z80AssParseNumber();

			if(n!=0x7fffffff)
			{
				value=n;
				alu=nalu;
				nalu=0;
			}
			else//not a number, probably a label
			{
				if((c>='a'&&c<='z')||c=='_'||c=='.')//label
				{
					if(c!='.') label=""; else label=Z80AssLabelScope;//local label, add preceding label scope

					while(Z80AssSourcePtr<Z80AssSourceLen)
					{
						c=Z80AssSource[Z80AssSourcePtr];

						if(!Z80AssLabelIsCharAllowed(c)) break;

						label+=charFromCode(c);
						++Z80AssSourcePtr;
					}

					if(pass==1)//pass 1
					{
						value=0;
						Z80AssLineList[Z80AssLine].compile=true;//lines with labels in equation will be compiled in pass 2
					}
					else//pass 2
					{
						found=false;

						for(i=0;i<Z80AssLabelList.length();++i)
						{
							if(Z80AssLabelList[i].name==label)
							{
								value=Z80AssLabelList[i].adr;
								found=true;
								break;
							}
						}

						if(!found)
						{
							Z80AssError("label '"+label+"' is not defined!");
							return 0;
						}

						alu=nalu;
						nalu=0;
					}
				}
				else//not a label, probably a math operator
				{
					if(nalu!=0&&nalu!='=')
					{
						Z80AssError("unexpected operation in an equation!");
						return 0;
					}

					nalu=c;
					++Z80AssSourcePtr;
				}
			}
		}

		if(alu!=0)
		{
			switch(alu)
			{
			case '=':
			case '+': result+=value; break;
			case '-': result-=value; break;
			case '*': result*=value; break;
			case '/': result/=value; break;
			case '&': result&=value; break;
			case '|': result|=value; break;
			case '^': result^=value; break;
			default:
				Z80AssError("unexpected int8acter in an equation!");
				return 0;
			}

			alu=0;
		}
	}

	return result;
}



void Z80AssParseDataArray(int s)
{
	int value;

	Z80AssSourcePtr+=3;

	while(Z80AssSourcePtr<Z80AssSourceLen)
	{
		if(Z80AssSource[Z80AssSourcePtr]=='\n') return;

		value=Z80AssParseEquation(Z80AssPass);

		if(s==1) Z80AssEmitByte(value); else Z80AssEmitWord(value);

		if(Z80AssSource[Z80AssSourcePtr]==',') ++Z80AssSourcePtr;
	}
}



bool Z80AssParseDirective(void)
{
	uint i,len;
	int value;

	if(Z80AssCompareSrcPart("db "))//parse string of db's
	{
		Z80AssParseDataArray(1);
		return true;
	}

	if(Z80AssCompareSrcPart("dw "))//parse string of dw's
	{
		Z80AssParseDataArray(2);
		return true;
	}

	if(Z80AssCompareSrcPart("ds "))//allocate bytes, with optional fill value
	{
		Z80AssSourcePtr+=3;

		len=Z80AssParseEquation(2);

		if(Z80AssSource[Z80AssSourcePtr]==',')
		{
			++Z80AssSourcePtr;
			value=Z80AssParseEquation(2);
		}
		else
		{
			value=0;
		}

		for(i=0;i<len;++i) Z80AssEmitByte(value);

		return true;
	}

	if(Z80AssCompareSrcPart("org "))
	{
		Z80AssSourcePtr+=4;
		Z80AssProgramCounter=Z80AssParseEquation(Z80AssPass);

		return true;
	}

	if(Z80AssCompareSrcPart("align "))
	{
		Z80AssSourcePtr+=6;
		value=Z80AssParseEquation(Z80AssPass);
		Z80AssProgramCounter=(Z80AssProgramCounter+value-1)&~(value-1);

		return true;
	}

	if(Z80AssCompareSrcPart("module "  )) return true;//allowed, doing nothing
	if(Z80AssCompareSrcPart("endmodule")) return true;

	if(Z80AssCompareSrcPart("if "))
	{
		Z80AssSourcePtr+=3;

		value=Z80AssParseEquation(2);	//always get actual value

		if(value==0)	//skip to next endif
		{
			while(Z80AssLine<Z80AssLinesAll)
			{
				++Z80AssLine;
				
				Z80AssSourcePtr=Z80AssLineList[Z80AssLine].off;

				Z80AssParseLabel();
				
				if(Z80AssCompareSrcPart("endif")) break;
			}
		}

		return true;
	}

	if(Z80AssCompareSrcPart("endif")) return true;
	
	return false;
}



int Z80AssParseOpcodePart(uint opcode_start,uint opcodes_all,uint rowlen)
{
	uint i,j,c,oplen,match,param_off,opcode,opcode_end;

	opcode_end=opcode_start+opcodes_all;

	for(opcode=opcode_start;opcode<opcode_end;++opcode)
	{
		oplen=Z80AssOpcodeLenList[opcode];

		if(Z80AssOpcodeList[opcode][0]!=':')
		{
			if(rowlen!=oplen) continue;
			
			match=0;
		}
		else
		{
			if(rowlen+2<oplen) continue;

			match=1;
		}

		param_off=0;

		Z80AssSourcePtr=Z80AssSourcePtrOld;

		for(j=match;j<oplen;++j)
		{
			c=Z80AssOpcodeList[opcode][j];

			if(c=='#'||c=='$'||c=='*'||c=='@')
			{
				Z80AssParamValue[param_off++]=Z80AssParseEquation(Z80AssPass);
				
				if(Z80AssStop) break;
			}
			else
			{
				if(c!=Z80AssSource[Z80AssSourcePtr++]) break;
			}
			
			++match;
		}

		if(match==oplen) return opcode;
	}
	
	return -1;
}



void Z80AssParseOpcode(void)
{
	uint i,j,c,len,rowlen,oplen,param_off,ptr;
	int opcode,value;

	rowlen=Z80AssSource.findFirst("\n",Z80AssSourcePtr)-Z80AssSourcePtr;//calculate line length
	
	if(rowlen==0) return;//empty opcode field

	Z80AssSourcePtrOld=Z80AssSourcePtr;

	c=Z80AssSource[Z80AssSourcePtr];

	if(Z80AssOpcodeLetterStartA[c]>=0)	//first try to search parameter-less opcode starting from given character
	{
		opcode=Z80AssParseOpcodePart(Z80AssOpcodeLetterStartA[c],Z80AssOpcodeLetterLenA[c],rowlen);
	}
	else
	{
		opcode=-1;
	}
	
	if(opcode<0)	//if no parameter-less opcode found, search all opcodes with parameters
	{
		opcode=Z80AssParseOpcodePart(Z80AssOpcodeLetterStartB[c],Z80AssOpcodeLetterLenB[c],rowlen);
	}
	
	if(opcode<0)
	{
		Z80AssError("unknown opcode or directive!");
		Z80AssStop=true;
		return;
	}

	ptr=Z80AssOpcodeLenList[opcode]+1;
	len=Z80AssOpcodeList[opcode].length();
	param_off=0;
	
	while(ptr<len)
	{
		c=Z80AssOpcodeList[opcode][ptr++];

		if((c>='0'&&c<='9')||(c>='a'&&c<='f'))
		{
			Z80AssEmitCode((Z80AssHexChar(c)<<4)|Z80AssHexChar(Z80AssOpcodeList[opcode][ptr++]));
			continue;
		}

		value=Z80AssParamValue[param_off++];

		switch(c)
		{
		case '#'://8-bit immediate
			Z80AssEmitByte(value);
			break;

		case '@'://16-bit immediate
			Z80AssEmitWord(value);
			break;

		case '$'://8-bit relative
			if(value>127) value-=Z80AssProgramCounter+1;//a hack to distinguish an absolute address from actual offset value

		case '*'://8-bit relative optional
			Z80AssEmitCode(Z80AssRelativeOffset(value));
			break;
		}
	}
}



void Z80AssParseLabel(void)
{
	uint i,c,lt,len;
	int value;
	string label;
	LabelStruct ls;

	if(Z80AssSource[Z80AssSourcePtr]!='@') return;

	Z80AssLineList[Z80AssLine].compile=true;//lines with labels needs to be compiled in the pass 2
	
	++Z80AssSourcePtr;

	lt=Z80AssSource[Z80AssSourcePtr];

	if(lt>='0'&&lt<='9')
	{
		Z80AssError("label can't start with a number!");
		return;
	}

	if(lt!='.') label=""; else label=Z80AssLabelScope;//local label, add preceding label scope

	value=Z80AssProgramCounter;

	while(Z80AssSourcePtr<Z80AssSourceLen)
	{
		c=Z80AssSource[Z80AssSourcePtr];

		if(c=='\n') break;//line break, not skipped

		++Z80AssSourcePtr;

		if(c==' '||c==':')//space or semicolon terminates label, needs to be skipped
		{
			if(Z80AssCompareSrcPart("equ "))//special case for equ
			{
				Z80AssSourcePtr+=4;
				value=Z80AssParseEquation(Z80AssPass);
				break;
			}

			if(Z80AssSource[Z80AssSourcePtr]==' ') ++Z80AssSourcePtr;//also skip space between semicolon and opcode
			break;
		}

		if(c=='=')
		{
			value=Z80AssParseEquation(Z80AssPass);
			break;
		}

		if(Z80AssLabelIsCharAllowed(c))
		{
			label+=charFromCode(c);
		}
		else
		{
			Z80AssError("wrong character in label name!");
			return;
		}
	}

	if(lt!='.') Z80AssLabelScope=label;//global label, set as new scope label

	if(Z80AssPass==1)
	{
		len=Z80AssLabelList.length();
		
		for(i=0;i<len;++i)
		{
			if(Z80AssLabelList[i].name==label)
			{
				Z80AssError("label already defined!");
				return;
			}
		}

		ls.name=label;
		ls.adr=value;

		Z80AssLabelList.insertLast(ls);
	}
}



void Z80AssDumpLabelList(void)
{
	for(uint i=0;i<Z80AssLabelList.length();++i) Print(Z80AssLabelList[i].name+" "+Z80AssLabelList[i].adr+"\n");
}



void Z80AssInit(void)
{
	uint i,c;
	
	//build list of opcode lengths
	
	Z80AssOpcodeListLen=Z80AssOpcodeList.length();
	
	for(i=0;i<Z80AssOpcodeListLen;++i) Z80AssOpcodeLenList[i]=Z80AssOpcodeList[i].findFirst("|");
	
	//build list of pointers to each possible first character, and number of opcodes starting from this character
	
	for(i=0;i<256;++i)
	{
		Z80AssOpcodeLetterStartA[i]=-1;
		Z80AssOpcodeLetterStartB[i]=-1;
		Z80AssOpcodeLetterLenA[i]=0;
		Z80AssOpcodeLetterLenB[i]=0;
	}

	for(i=0;i<Z80AssOpcodeListLen;++i)
	{
		c=Z80AssOpcodeList[i][0];

		if(c!=':')
		{
			if(Z80AssOpcodeLetterStartA[c]< 0) Z80AssOpcodeLetterStartA[c]=i;
			if(Z80AssOpcodeLetterStartA[c]>=0) Z80AssOpcodeLetterLenA  [c]++;
		}
		else
		{
			c=Z80AssOpcodeList[i][1];

			if(Z80AssOpcodeLetterStartB[c]< 0) Z80AssOpcodeLetterStartB[c]=i;
			if(Z80AssOpcodeLetterStartB[c]>=0) Z80AssOpcodeLetterLenB  [c]++;
		}
	}
}



string Z80AssSourceCleanup(string src)
{
	uint i,c,sptr,spaces,prevc,size,len,slen;
	bool newline,label;
	string dst;
	
	//similar to pass 0 of actual compilation
	
	dst="";
	
	newline=true;
	label=false;
	sptr=0;
	spaces=0;
	prevc=255;
	
	slen=src.length();
	
	while(sptr<slen)
	{
		c=src[sptr++];

		if(c==0x09||c==0x0d) c=0x20;//tabs and returns to spaces

		if(c==0x20&&c==prevc) continue; else prevc=c;//skip multiple spaces

		if(c>='A'&&c<='Z') c+=0x20;//to lower case

		if(c==';')//skip comments
		{
			sptr=src.findFirst("\n",sptr);
			continue;
		}

		if(c==0x20) ++spaces;

		if(newline) if(c>0x20) label=true; else dst+=" ";

		len=dst.length();
		
		if(c=='\n'&&len!=0)//remove any trailing spaces and repeating new lines
		{
			for(i=len-1;i>0;--i)
			{
				if(dst[i]!=0x20&&dst[i]!='\n')
				{
					dst.resize(i+1);
					break;
				}
			}
		}

		if(c!=0x20||(label&&spaces==1)||spaces==2) dst+=charFromCode(c);

		if(c=='\n')
		{
			newline=true;
			label=false;
			spaces=0;
		}
		else
		{
			newline=false;
		}
	}

	dst+="\n";
	
	return dst;
}



int Z80AssCompile(string src,uint adr)
{
	uint i,c,sptr,spaces,prevc,size,len,slen;
	bool newline,label;
	LineStruct line;

	//ProfileStart();
	
	Z80AssOriginalSource=src;

	Z80AssSource="";
	Z80AssSourcePtr=0;

	//pass 0 creates a copy of the source code without all unneeded spaces and comments, with labels marked with @
	//also makes all text lower case (labels are case-insensitive)
	//original source code remains untouched and used in error reports
	//the only spaces kept are space between an op and a parameter, and space between a label and an op

	newline=true;
	label=false;
	sptr=0;
	spaces=0;
	prevc=255;
	
	Z80AssLineList.resize(0);
	
	line.off=0;
	line.adr=0;
	line.compile=false;
	
	slen=Z80AssOriginalSource.length();
	
	while(sptr<slen)
	{
		c=Z80AssOriginalSource[sptr++];

		if(c==0x09||c==0x0d) c=0x20;//tabs and returns to spaces

		if(c==0x20&&c==prevc) continue; else prevc=c;//skip multiple spaces

		if(c>='A'&&c<='Z') c+=0x20;//to lower case

		if(c==';')//skip comments
		{
			sptr=Z80AssOriginalSource.findFirst("\n",sptr);
			continue;
		}

		if(newline&&c>0x20)//mark labels
		{
			Z80AssSource+="@";
			label=true;
		}

		if(c==0x20) ++spaces;

		len=Z80AssSource.length();
		
		if(c=='\n'&&len!=0)//remove any trailing spaces and repeating new lines
		{
			for(i=len-1;i>0;--i)
			{
				if(Z80AssSource[i]!=0x20)
				{
					Z80AssSource.resize(i+1);
					break;
				}
			}
		}

		if(c!=0x20||(label&&spaces==1)||spaces==2) Z80AssSource+=charFromCode(c);

		if(c=='\n')
		{
			Z80AssLineList.insertLast(line);
			
			line.off=Z80AssSource.length();
			
			newline=true;
			label=false;
			spaces=0;
		}
		else
		{
			newline=false;
		}
	}

	Z80AssLineList.insertLast(line);
	
	Z80AssSource+="\n";

	Z80AssSourceLen=Z80AssSource.length();
	Z80AssLinesAll=Z80AssLineList.length();
	
	//pass 1 translates code with zeroes instead of parameters and calculates labels in the process

	Z80AssLabelList.resize(0);
	Z80AssStop=false;

	Z80AssPass=1;
	Z80AssLabelScope="";

	Z80AssProgramCounter=adr;

	for(Z80AssLine=0;Z80AssLine<Z80AssLinesAll;++Z80AssLine)
	{
		Z80AssSourcePtr=Z80AssLineList[Z80AssLine].off;
		Z80AssLineList[Z80AssLine].adr=Z80AssProgramCounter;
		
		Z80AssParseLabel();
		
		if(!Z80AssParseDirective()) Z80AssParseOpcode();//parse opcode or directive
		
		if(Z80AssStop) break;
	}

	size=Z80AssProgramCounter-adr;

	//Z80AssDumpLabelList();
	
	//pass 2 translates only those lines that weren't compiled in the pass 1 because labels weren't defined

	Z80AssPass=2;
	Z80AssLabelScope="";

	for(Z80AssLine=0;Z80AssLine<Z80AssLinesAll;++Z80AssLine)
	{
		if(!Z80AssLineList[Z80AssLine].compile) continue;
		
		Z80AssSourcePtr=Z80AssLineList[Z80AssLine].off;
		Z80AssProgramCounter=Z80AssLineList[Z80AssLine].adr;
		
		Z80AssParseLabel();
		
		if(!Z80AssParseDirective()) Z80AssParseOpcode();//parse opcode or directive
		
		if(Z80AssStop) break;
	}

	//Z80AssDumpLabelList();
	
	//cleanup
	
	Z80AssSource.resize(0);
	Z80AssOriginalSource.resize(0);
	Z80AssLabelList.resize(0);
	Z80AssLineList.resize(0);

	//ProfileEnd();

	return Z80AssStop?-1:size;
}
